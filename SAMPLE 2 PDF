///////////////////////////////////////////
// File format structure
///////////////////////////////////////////
SEPARATOR;semicolon

///////////////////////////////////////////
// Data structure
///////////////////////////////////////////
SELECT;CELLSEARCH(".*Date de détachement.*")
CONSTANT;DCELL;CELLRANGE(SELECTION.LINE,SELECTION.COL+1)

SELECT;CELLSEARCH(".*Parts(s) distribuante(s).*")
FIRSTCOLUMN;SELECTION.COL+1
FIRSTLINE.SELECTION.LINE+1

///////////////////////////////////////////
// Data modifications
///////////////////////////////////////////
SET;;PURIFY(CURCELL)


///////////////////////////////////////////
// Assertions on file format
///////////////////////////////////////////
//ASSERT;;IsNum(CURCELL)

///////////////////////////////////////////
// Identification (NAMETREE or SOURCE_CODE)
///////////////////////////////////////////
NAMETREE;ExcelColName(FIRSTCOLUMN-1)
NAMETREE;FIRSTLINE-1

IDENTIFIER;NAMETREE;

///////////////////////////////////////////
// Format Date
///////////////////////////////////////////
SET;DCELL;READDATEDICO(CURCELL)
DATE;DD/MM/YYYY;CELL(DCELL)

///////////////////////////////////////////
// Data to ignore
///////////////////////////////////////////
IGNORE;ISEMPTY(CURCELL)


///////////////////////////////////////////
// Execute the profile
///////////////////////////////////////////
RUN_LOADTS;decimal_delimiter=point,thousand_delimiter=none,updatena=no,update_mode=update_diffdb

EOF
